# -----------------------------
# Vercel / API server
# -----------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
INGEST_SECRET=replace-with-a-long-random-secret

# 기존 배포와의 호환용. INGEST_SECRET를 쓰는 경우 불필요합니다.
# CRON_SECRET=replace-with-a-long-random-secret

# -----------------------------
# Local collector (09:00 KST)
# -----------------------------
ITS_API_KEY=replace-with-your-its-api-key
INGEST_URL=https://YOUR_PROJECT.vercel.app/api/ingest
INGEST_SECRET=replace-with-the-same-secret-as-vercel

# 선택: 미설정 시 INGEST_URL 기준으로 /api/attempt를 자동 계산합니다.
# ATTEMPT_URL=https://YOUR_PROJECT.vercel.app/api/attempt
