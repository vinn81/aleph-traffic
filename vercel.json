{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/edge-test",
      "destination": "/api/edge-test"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/collect",
      "schedule": "0 0 * * *"
    }
  ]
}
