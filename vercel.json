{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/verify",
      "destination": "/verify.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/check-missed",
      "schedule": "0 1 * * *"
    }
  ]
}
